                  },
                  "comment": {
                    "shortText": "Challenge ID from startRegistration"
                  }
                },
                {
                  "name": "credential",
                  "type": {
                    "type": "nameOnly",
                    "name": "ServerCredentialResponse"
                  },
                  "comment": {
                    "shortText": "Serialized credential from navigator.credentials.create()"
                  }
                }
              ]
            }
          }
        ],
        "ret": {
          "type": {
            "type": "promise",
            "name": "Promise",
            "awaited": {
              "type": "union",
              "name": "AuthPasskeyRegistrationVerifyResponse",
              "subTypes": [
                {
                  "type": "object",
