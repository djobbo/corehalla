                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "options",
                      "type": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "captchaToken",
                            "type": {
