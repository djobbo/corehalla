        "comment": {
          "shortText": "Verifies a code against a challenge. The verification code is\\nprovided by the user by entering a code seen in their authenticator app.",
          "text": "- To verify a challenge, please [create a challenge](/docs/reference/javascript/auth-mfa-challenge) first.",
          "examples": [
            {
              "id": "verify-a-challenge-for-a-factor",
              "name": "Verify a challenge for a factor",
              "code": "\`\`\`js\\nconst { data, error } = await supabase.auth.mfa.verify({\\n  factorId: '34e770dd-9ff9-416c-87fa-43b31d7ef225',\\n  challengeId: '4034ae6f-a8ce-4fb5-8ee5-69a5863a7c15',\\n  code: '123456'\\n})\\n\`\`\`",
