        "comment": {
          "shortText": "Creates a new anonymous user.",
          "text": "- Returns an anonymous user\\n- It is recommended to set up captcha for anonymous sign-ins to prevent abuse. You can pass in the captcha token in the \`options\` param.",
          "examples": [
            {
              "id": "create-an-anonymous-user",
              "name": "Create an anonymous user",
              "code": "\`\`\`js\\nconst { data, error } = await supabase.auth.signInAnonymously({\\n  options: {\\n    captchaToken\\n  }\\n});\\n\`\`\`",
