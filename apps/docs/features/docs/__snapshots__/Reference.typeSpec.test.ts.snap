                        }
                      },
                      {
                        "name": "quality",
                        "type": {
                          "type": "intrinsic",
                          "name": "number"
                        },
                        "isOptional": true,
                        "comment": {
                          "shortText": "Set the quality of the returned image.\\nA number from 20 to 100, with 100 being the highest quality.\\nDefaults to 80"
                        }
                      },
                      {
                        "name": "resize",
                        "type": {
                          "type": "union",
                          "subTypes": [
                            {
                              "type": "literal",
                              "value": "cover"
                            },
