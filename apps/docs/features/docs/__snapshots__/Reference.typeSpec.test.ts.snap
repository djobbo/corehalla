                      }
                    },
                    {
                      "name": "error",
                      "type": {
                        "type": "literal",
                        "value": null
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "data",
                      "type": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "messageId",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          },
                          {
                            "name": "session",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          },
                          {
                            "name": "user",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
