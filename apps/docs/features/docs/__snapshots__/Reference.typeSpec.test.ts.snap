  {
    "name": "@supabase/postgrest-js",
    "methods": {
      "@supabase/postgrest-js.PostgrestBuilder.constructor": {
        "name": "@supabase/postgrest-js.PostgrestBuilder.constructor",
        "params": [
          {
            "name": "builder",
            "type": {
              "type": "object",
              "properties": [
                {
                  "name": "body",
                  "type": {
                    "type": "intrinsic",
                    "name": "unknown"
                  },
                  "isOptional": true
                },
                {
                  "name": "fetch",
                  "type": {
                    "type": "function",
                    "params": [
                      {
                        "name": "input",
