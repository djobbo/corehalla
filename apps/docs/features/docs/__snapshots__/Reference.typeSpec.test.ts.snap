      "@supabase/storage-js.StorageClient.constructor": {
        "name": "@supabase/storage-js.StorageClient.constructor",
        "params": [
          {
            "name": "url",
            "type": {
              "type": "intrinsic",
              "name": "string"
            }
          },
          {
            "name": "headers",
