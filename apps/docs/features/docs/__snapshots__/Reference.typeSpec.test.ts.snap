      "@supabase/supabase-js.PostgrestFilterBuilder.notIn": {
        "name": "@supabase/supabase-js.PostgrestFilterBuilder.notIn",
        "params": [
          {
            "name": "column",
            "type": {
              "type": "nameOnly",
              "name": "ColumnName"
            },
            "comment": {
              "shortText": "The column to filter on"
