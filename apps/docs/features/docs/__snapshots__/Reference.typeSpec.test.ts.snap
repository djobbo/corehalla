                    {
                      "name": "error",
                      "type": {
                        "type": "nameOnly",
                        "name": "StorageError"
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        "comment": {
          "shortText": "Retrieves the details of an existing file.\\n\\nReturns detailed file metadata including size, content type, and timestamps.\\nNote: The API returns \`last_modified\` field, not \`updated_at\`.",
          "examples": [
            {
              "id": "get-file-info",
              "name": "Get file info",
              "code": "\`\`\`js\\nconst { data, error } = await supabase\\n  .storage\\n  .from('avatars')\\n  .info('folder/avatar1.png')\\n\\nif (data) {\\n  console.log('Last modified:', data.lastModified)\\n  console.log('Size:', data.size)\\n}\\n\`\`\`"
            }
          ]
        }
      },
