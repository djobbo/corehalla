                "type": "intrinsic",
                "name": "string"
              },
              "valueType": {
                "type": "intrinsic",
                "name": "string"
              }
            }
          },
          {
            "name": "fetch",
            "type": {
              "type": "function",
              "params": [
                {
                  "name": "input",
                  "type": {
                    "type": "union",
                    "subTypes": [
                      {
                        "type": "nameOnly",
