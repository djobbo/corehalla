          "examples": [
            {
              "id": "with-select",
              "name": "With \`select()\`",
              "code": "\`\`\`ts\\nconst { data, error } = await supabase\\n  .from('characters')\\n  .select()\\n  .in('name', ['Leia', 'Han'])\\n\`\`\`",
              "data": {
                "sql": "\`\`\`sql\\ncreate table\\n  characters (id int8 primary key, name text);\\n\\ninsert into\\n  characters (id, name)\\nvalues\\n  (1, 'Luke'),\\n  (2, 'Leia'),\\n  (3, 'Han');\\n\`\`\`"
              },
              "response": "\`\`\`json\\n{\\n  \\"data\\": [\\n    {\\n      \\"id\\": 2,\\n      \\"name\\": \\"Leia\\"\\n    },\\n    {\\n      \\"id\\": 3,\\n      \\"name\\": \\"Han\\"\\n    }\\n  ],\\n  \\"status\\": 200,\\n  \\"statusText\\": \\"OK\\"\\n}\\n\`\`\`"
            }
          ]
        }
      },
