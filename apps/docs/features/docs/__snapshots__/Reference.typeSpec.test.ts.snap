              "name": "List buckets with options",
              "code": "\`\`\`js\\nconst { data, error } = await supabase\\n  .storage\\n  .listBuckets({\\n    limit: 10,\\n    offset: 0,\\n    sortColumn: 'created_at',\\n    sortOrder: 'desc',\\n    search: 'prod'\\n  })\\n\`\`\`"
