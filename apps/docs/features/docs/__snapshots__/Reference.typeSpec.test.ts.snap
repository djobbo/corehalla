                        "type": "literal",
                        "value": null
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "data",
                      "type": {
                        "type": "literal",
                        "value": null
                      }
                    },
                    {
                      "name": "error"
                    }
                  ]
                }
              ]
            }
          }
        },
        "comment": {
          "shortText": "Deletes a specific passkey for a specific user.\\n\\nThis function should only be called on a server. Never expose your \`service_role\` key in the browser."
        }
      },
