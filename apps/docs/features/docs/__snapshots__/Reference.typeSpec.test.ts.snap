                          "name": "PromiseLike"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "isOptional": true,
            "comment": {
              "shortText": "The callback to execute when the Promise is resolved."
            }
          },
          {
            "name": "onrejected",
            "type": {
              "type": "union",
              "subTypes": [
