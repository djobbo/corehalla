      "@supabase/auth-js.GoTrueClient.signInAnonymously": {
        "name": "@supabase/auth-js.GoTrueClient.signInAnonymously",
        "params": [
          {
            "name": "credentials",
            "type": {
              "name": "SignInAnonymouslyCredentials",
              "type": "object",
              "properties": [
                {
                  "name": "options",
                  "type": {
                    "type": "object",
                    "properties": [
                      {
                        "name": "captchaToken",
