                },
                "isOptional": true
              }
            ],
            "ret": {
              "type": {
                "type": "nameOnly",
                "name": "WebSocket"
              }
            }
          }
        },
        "comment": {
          "shortText": "Returns the best available WebSocket constructor for the current runtime.",
          "examples": [
            {
              "id": "example-with-error-handling",
              "name": "Example with error handling",
              "code": "\`\`\`ts\\ntry {\\n  const WS = WebSocketFactory.getWebSocketConstructor()\\n  const socket = new WS('wss://example.com/socket')\\n} catch (error) {\\n  console.error('WebSocket not available in this environment.', error)\\n}\\n\`\`\`"
            }
          ]
        }
      },
      "@supabase/supabase-js.WebSocketFactory.isWebSocketSupported": {
