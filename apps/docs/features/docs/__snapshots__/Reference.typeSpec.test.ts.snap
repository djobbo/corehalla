                        "value": true
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "error",
                      "type": {
                        "type": "intrinsic",
                        "name": "string"
                      }
                    },
                    {
                      "name": "status",
                      "type": {
                        "type": "intrinsic",
