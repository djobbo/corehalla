                                            "type": {
                                              "type": "array",
                                              "elemType": {
                                                "type": "object",
                                                "name": "UserIdentity",
                                                "properties": [
                                                  {
                                                    "name": "created_at",
                                                    "type": {
                                                      "type": "intrinsic",
                                                      "name": "string"
                                                    },
                                                    "isOptional": true
                                                  },
                                                  {
