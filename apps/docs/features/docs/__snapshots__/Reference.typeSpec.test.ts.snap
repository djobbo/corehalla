              "name": "Override type of successful response",
              "code": "\`\`\`ts\\nconst { data } = await supabase\\n  .from('countries')\\n  .select()\\n  .returns<Array<MyType>>()\\n\`\`\`",
              "response": "\`\`\`js\\nlet x: typeof data // MyType[]\\n\`\`\`"
