                                                "shortText": "The verification status of the factor, default is \`unverified\` after \`.enroll()\`, then \`verified\` after the user verifies it with \`.verify()\`"
                                              }
                                            },
                                            {
                                              "name": "updated_at",
                                              "type": {
                                                "type": "intrinsic",
                                                "name": "string"
                                              }
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  },
                                  "isOptional": true
                                },
                                {
                                  "name": "id",
                                  "type": {
                                    "type": "intrinsic",
                                    "name": "string"
                                  }
                                },
                                {
                                  "name": "identities",
                                  "type": {
                                    "type": "array",
                                    "elemType": {
                                      "type": "object",
                                      "name": "UserIdentity",
                                      "properties": [
                                        {
                                          "name": "created_at",
                                          "type": {
                                            "type": "intrinsic",
                                            "name": "string"
                                          },
                                          "isOptional": true
                                        },
                                        {
                                          "name": "id",
                                          "type": {
                                            "type": "intrinsic",
                                            "name": "string"
                                          }
                                        },
                                        {
                                          "name": "identity_data",
                                          "type": {
                                            "type": "index signature",
                                            "keyType": {
                                              "type": "intrinsic",
                                              "name": "string"
                                            },
                                            "valueType": {
                                              "type": "intrinsic",
                                              "name": "any"
                                            }
                                          },
                                          "isOptional": true
