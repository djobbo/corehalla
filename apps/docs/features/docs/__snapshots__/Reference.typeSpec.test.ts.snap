        "ret": {
          "type": {
            "type": "promise",
            "name": "Promise",
            "awaited": {
              "type": "union",
              "name": "AuthOtpResponse",
              "subTypes": [
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "data",
                      "type": {
                        "type": "object",
                        "properties": [
