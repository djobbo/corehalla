              "valueType": {
                "type": "intrinsic",
                "name": "any"
              }
            }
          }
        ],
        "ret": {
          "type": {
            "type": "intrinsic",
            "name": "void"
          }
        },
        "comment": {
          "shortText": "Updates the payload that will be sent the next time the channel joins (reconnects).\\nUseful for rotating access tokens or updating config without re-creating the channel."
        }
      },
