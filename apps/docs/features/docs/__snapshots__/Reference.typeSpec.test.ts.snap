                      }
                    }
                  ],
                  "ret": {
                    "type": {
                      "type": "intrinsic",
                      "name": "void"
                    }
                  }
                }
              }
            ],
            "ret": {
              "type": {
                "type": "nameOnly",
                "name": "RealtimeChannel"
              }
