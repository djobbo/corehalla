        ],
        "ret": {
          "type": {
            "type": "intrinsic",
            "name": "this"
          }
        },
        "comment": {
          "shortText": "Set an HTTP header for the request.\\nCreates a shallow copy of headers to avoid mutating shared state."
        }
      },
      "@supabase/storage-js.packages/StorageAnalyticsClient.default.throwOnError": {
        "name": "@supabase/storage-js.packages/StorageAnalyticsClient.default.throwOnError",
        "params": [],
        "ret": {
          "type": {
