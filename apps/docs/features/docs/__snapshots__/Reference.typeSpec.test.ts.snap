                                    "name": "UserMetadata",
                                    "properties": []
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "name": "error",
                      "type": {
                        "type": "literal",
                        "value": null
                      }
                    }
                  ]
                },
                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "data",
                      "type": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "user",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          }
                        ]
