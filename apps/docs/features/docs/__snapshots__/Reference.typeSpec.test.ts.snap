        "comment": {
          "shortText": "Detects whether the runtime can establish WebSocket connections.",
          "examples": [
            {
              "id": "example-in-a-node-js-script",
              "name": "Example in a Node.js script",
              "code": "\`\`\`ts\\nif (!WebSocketFactory.isWebSocketSupported()) {\\n  console.error('WebSockets are required for this script.')\\n  process.exitCode = 1\\n}\\n\`\`\`"
            }
          ]
        }
      },
