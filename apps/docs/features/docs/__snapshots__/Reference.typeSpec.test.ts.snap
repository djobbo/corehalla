                                                        "name": "last_challenged_at",
                                                        "type": {
                                                          "type": "intrinsic",
                                                          "name": "string"
                                                        },
                                                        "isOptional": true
                                                      },
                                                      {
                                                        "name": "status",
                                                        "type": {
                                                          "type": "union",
