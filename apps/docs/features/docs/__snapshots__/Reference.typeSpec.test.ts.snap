                                    "name": "UserMetadata",
                                    "properties": []
                                  }
                                }
                              ]
                            }
                          },
                          {
                            "name": "weakPassword",
                            "type": {
                              "name": "WeakPassword",
                              "type": "object",
                              "properties": [
                                {
                                  "name": "message",
                                  "type": {
