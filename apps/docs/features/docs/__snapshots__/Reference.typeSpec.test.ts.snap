                {
                  "type": "object",
                  "properties": [
                    {
                      "name": "data",
                      "type": {
                        "type": "object",
                        "properties": [
                          {
                            "name": "session",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          },
                          {
                            "name": "user",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          },
                          {
                            "name": "weakPassword",
                            "type": {
                              "type": "literal",
                              "value": null
                            }
                          }
