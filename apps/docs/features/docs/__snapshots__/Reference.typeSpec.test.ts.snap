                                "type": {
                                  "type": "intrinsic",
                                  "name": "number"
                                }
                              },
                              {
                                "name": "statusText",
                                "type": {
                                  "type": "intrinsic",
                                  "name": "string"
                                }
                              },
                              {
                                "name": "success",
                                "type": {
                                  "type": "literal",
                                  "value": false
                                }
                              }
                            ]
                          }
                        ]
                      }
                    }
                  ],
                  "ret": {
                    "type": {
                      "type": "union",
                      "subTypes": [
                        {
                          "type": "nameOnly",
                          "name": "TResult1"
                        },
                        {
                          "type": "nameOnly",
                          "name": "PromiseLike"
                        }
                      ]
                    }
                  }
                }
              ]
            },
            "isOptional": true,
            "comment": {
              "shortText": "The callback to execute when the Promise is resolved."
            }
          },
          {
            "name": "onrejected",
            "type": {
              "type": "union",
              "subTypes": [
                {
                  "type": "literal",
                  "value": null
                },
                {
                  "type": "function",
                  "params": [
                    {
                      "name": "reason",
                      "type": {
                        "type": "intrinsic",
