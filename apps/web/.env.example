# Corehalla (TanStack Start) environment variables
#
# Copy to `.env` for the values you own. There is no database URL any more: the
# database is a Cloudflare D1 binding (`DB`), supplied by the Alchemy stack
# (`web/alchemy.run.ts`) and read through `src/env.ts`.
#
# Server-only values are read at request time and never reach the browser.
# `VITE_`/`NEXT_PUBLIC_` values are inlined into the client bundle and must not
# contain secrets.

# --- server only ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY
SITE_URL=https://dev.corehalla.com
# Discord OAuth application (https://discord.com/developers/applications).
# The redirect URL to register is `${SITE_URL}/api/auth/discord/callback`.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Origin used for server-side atom preloading (defaults to SITE_URL or
# http://localhost:$PORT).
INTERNAL_ORIGIN=

# --- public (browser) ---
VITE_GA_TRACKING_ID=
# Cloudflare Web Analytics. Leave empty while the site is proxied through
# Cloudflare with automatic injection enabled (Web Analytics -> Add a site ->
# pick the hostname). Set it to the token from the dashboard's JS snippet only
# for manual installation. Cookieless either way, so it needs no consent.
# Do not set both: only one beacon may run per page.
VITE_CF_BEACON_TOKEN=
# AdSense publisher ID (the `pub-…` part, without the `ca-` prefix).
VITE_ADSENSE_ID=
#
# Ad unit IDs, one per manual placement (AdSense → Ads → By ad unit → the
# numeric `data-ad-slot`). They are optional: any placement left unset falls
# back to the original profile-header unit so the slot still renders.
#
#   profile header overlay   landing "Latest News" last card
#   profile bottom (player/clan)   rankings + clan search
#   landing search bar
VITE_ADSENSE_SLOT_PROFILE_HEADER=
VITE_ADSENSE_SLOT_PROFILE_BOTTOM=
VITE_ADSENSE_SLOT_ARTICLES=
VITE_ADSENSE_SLOT_RANKINGS=
VITE_ADSENSE_SLOT_LANDING=
#
# IMPORTANT — turn off Auto ads in the AdSense dashboard.
#
# The app only renders the manual units above. Google's Auto ads are an
# account-level setting and are *not* controlled by this code: while they are
# on, the AdSense loader script injects its own units on every page, including
# the full-screen vignette interstitial. To keep ads limited to the placements
# above, sign in to AdSense → Ads → (your site) → Edit and either turn Auto ads
# off, or use "Overlay formats" to turn off Vignette/Anchor ads and "In-page
# formats" to turn off auto in-page units. Changes can take up to an hour.

# --- app secrets (read by the app, and bound at deploy) ---
#
# `vp dev` reads this file, and the `pnpm dev:cloud` / `pnpm deploy` scripts load
# it into the process so the Alchemy stack can bind the same values.
#
# Cloudflare credentials for Alchemy itself belong in the **repo-root** `.env`,
# or use an OAuth profile (env credentials win over a profile):
#   pnpm exec alchemy profile edit --add Cloudflare
#   pnpm exec alchemy provider check-env      # show what is missing
# A scoped API token needs Workers Scripts: Edit, D1: Edit, Secrets Store: Edit
# (plus Account Settings: Read for the workers.dev subdomain lookup).
