{
    "name": "@crh/cms",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "emdash": {
        "seed": "seed/seed.json"
    },
    "scripts": {
        "dev": "astro dev --port 3002 --config astro.config.local.mjs",
        "build": "astro build --config astro.config.standalone.mjs",
        "preview": "astro preview",
        "ts:check": "tsrs --noEmit && effect-tsrs diagnostics --project tsconfig.json",
        "dev:standalone": "astro dev --port 3002 --config astro.config.standalone.mjs",
        "seed": "emdash seed seed/seed.json --database ./emdash.db --uploads-dir ./data/uploads --on-conflict=update",
        "seed:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-media.mts"
    },
    "dependencies": {
        "@astrojs/cloudflare": "catalog:",
        "@astrojs/react": "catalog:",
        "@emdash-cms/cloudflare": "catalog:",
        "astro": "catalog:",
        "emdash": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:",
        "@astrojs/node": "catalog:"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "catalog:",
        "@astrojs/check": "catalog:",
        "@cloudflare/workers-types": "catalog:",
        "@types/node": "catalog:",
        "typescript": "catalog:",
        "@effect/platform-node": "catalog:"
    }
}
