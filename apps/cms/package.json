{
    "name": "@crh/cms",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "emdash": {
        "seed": "seed/seed.json"
    },
    "scripts": {
        "dev": "astro dev --port 3002 --config astro.config.local.mjs",
        "build": "astro build --config astro.config.standalone.mjs",
        "preview": "astro preview",
        "ts:check": "tsrs --noEmit && effect-tsrs diagnostics --project tsconfig.json",
        "dev:standalone": "astro dev --port 3002 --config astro.config.standalone.mjs",
        "seed": "emdash seed seed/seed.json --database ./emdash.db --uploads-dir ./data/uploads --on-conflict=update",
        "seed:media": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-media.mts"
    },
    "dependencies": {
        "@astrojs/cloudflare": "14.3.1",
        "@astrojs/react": "7.0.0",
        "@emdash-cms/cloudflare": "^1.3.0",
        "astro": "7.3.2",
        "emdash": "^1.3.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "@astrojs/node": "^11.1.9"
    },
    "devDependencies": {
        "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
        "@astrojs/check": "^0.9.10",
        "@cloudflare/workers-types": "^5.20261023.1",
        "@types/node": "^24.0.0",
        "typescript": "^7.0.2",
        "@effect/platform-node": "4.0.6"
    }
}
