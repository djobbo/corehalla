{
    "extends": "astro/tsconfigs/base",
    "compilerOptions": {
        "types": ["node", "@cloudflare/workers-types"],
        "plugins": [
            {
                "name": "@effect/language-service",
                "diagnostics": true,
                "allowedUnstableApis": [
                    "effect/http",
                    "effect/FileSystem",
                    "effect/Path",
                    "@effect/platform-node"
                ],
                "includeSuggestionsInTsc": false,
                "ignoreEffectWarningsInTscExitCode": true
            }
        ]
    },
    "include": [
        "src",
        "scripts",
        ".astro/types.d.ts",
        "emdash-env.d.ts",
        "astro.config.base.mjs"
    ]
}
