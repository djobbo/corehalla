# Root environment for local development tooling.
#
# The Supabase CLI resolves `env(...)` references in `supabase/config.toml`
# from the ambient environment, then `supabase/.env*`, then this file — so the
# values here configure the *local stack* (Discord is the app's only OAuth
# provider).
#
# Everything else (`SUPABASE_URL`, keys, `DATABASE_URL`) is written into each
# package's env file by `pnpm setup:env`, which reads them back from
# `supabase status`. Only set what you need on top of that.

# Discord OAuth app credentials (https://discord.com/developers/applications).
# The local redirect URL to register is:
#   http://localhost:54321/auth/v1/callback
DISCORD_AUTH_CLIENT_ID=
DISCORD_AUTH_SECRET=
