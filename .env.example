# Repo-root environment. Gitignored `.env` is the only env file.
# `dev` / `deploy` / `destroy` pass it as `alchemy … --env-file .env`. Vite
# reads it via `envDir`.

# Alchemy profile that holds the Cloudflare credentials.
#   vp exec alchemy profile edit --profile corehalla --add Cloudflare
ALCHEMY_PROFILE=corehalla
# Or set credentials directly (they take precedence over the profile):
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_EMAIL=

# --- app ---
BRAWLHALLA_API_KEY=
SITE_URL=https://dev.corehalla.com
# Discord OAuth. Register `${SITE_URL}/api/auth/discord/callback`.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
INTERNAL_ORIGIN=

# Public values inlined into the client bundle. Do not put secrets here.
VITE_GA_TRACKING_ID=
VITE_CF_BEACON_TOKEN=
VITE_ADSENSE_ID=
VITE_ADSENSE_SLOT_PROFILE_HEADER=
VITE_ADSENSE_SLOT_PROFILE_BOTTOM=
VITE_ADSENSE_SLOT_ARTICLES=
VITE_ADSENSE_SLOT_RANKINGS=
VITE_ADSENSE_SLOT_LANDING=
# Auto ads are an account setting, not a variable. AdSense → Ads → (site) →
# Edit: turn Auto ads off, or disable Vignette/Anchor and auto in-page units.
# Otherwise the loader injects units on every page. Changes can take an hour.

# One-off Supabase -> D1 import (`vp run db:import:supabase`).
# Use the session-pooler URL (`sslmode=require`); the direct host is IPv6-only.
SOURCE_DATABASE_URL=
D1_DATABASE_NAME=corehalla

# Discord manager bot (`apps/worker`). The bot talks to D1 over HTTP.
CLOUDFLARE_D1_DATABASE_ID=
DISCORD_MANAGER_BOT_TOKEN=
DISCORD_MANAGER_BOT_DEV_GUILD_ID=
DISCORD_MANAGER_BOT_CLIENT_ID=
DISCORD_CHANNEL_SWITCHER_VOICE_LOGS_CHANNEL_ID=
DISCORD_CHANNEL_SWITCHER_GENERATOR_CATEGORY_ID=
DISCORD_CHANNEL_SWITCHER_LOBBYS_CATEGORY_ID=
