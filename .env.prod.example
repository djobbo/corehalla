# Corehalla production environment variables
#
# Read by `pnpm --filter web deploy` (Alchemy -> Cloudflare) and
# `pnpm db:migrate:prod`. See `web/.env.example` for the full reference.

# --- Brawlhalla API ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY

# --- Supabase Postgres (Hyperdrive origin) ---
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=SUPER_SECRET_DB_PASSWORD
# Same origin; used by `pnpm db:migrate:prod`.
DATABASE_URL=postgres://postgres:SUPER_SECRET_DB_PASSWORD@db.<project-ref>.supabase.co:5432/postgres

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Site ---
SITE_URL=https://corehalla.com
