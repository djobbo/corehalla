{
    "extends": "@crh/tsconfig/base.json",
    "include": ["."],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "plugins": [
            {
                "name": "@effect/language-service",
                "diagnostics": true,
                "allowedUnstableApis": [
                    "effect/http",
                    "effect/FileSystem",
                    "effect/Path",
                    "@effect/platform-node",
                    "@effect/vitest"
                ],
                "includeSuggestionsInTsc": false,
                "ignoreEffectWarningsInTscExitCode": true
            }
        ]
    }
}
