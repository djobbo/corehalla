# Source database for the one-off Supabase -> D1 conversion
# (`pnpm db:import:supabase`, which loads this file with
# `node --env-file-if-exists=.env`). Read-only; never needed at deploy or runtime.
#
# Use the Supabase **session pooler** connection string: the direct
# `db.<ref>.supabase.co` host is IPv6-only, and the transaction pooler does not
# keep a session. `sslmode=require` is what the import script expects by default
# (`--ssl=verify` to also verify the CA).
#
#   pnpm db:import:supabase -- --source="postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
#
SOURCE_DATABASE_URL=

# Cloudflare credentials for the manual D1 steps in this package.
#
# The schema is applied by Alchemy at deploy, and the local schema + seed check
# (`pnpm db:seed:verify`) needs no credentials at all. These are only for the
# one-off remote import of the generated SQL:
#
#   pnpm dlx wrangler d1 execute corehalla --remote --file=seed/generated/seed.sql --yes
#
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Name of the D1 database (matches `alchemy.run.ts` at the repo root).
D1_DATABASE_NAME=corehalla
