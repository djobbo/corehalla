{
    "name": "db",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "db:migrate": "vp run db:supabase:clean && prisma migrate dev && vp run db:supabase:setup",
        "db:migrate:prod": "vp run db:supabase:clean && prisma migrate deploy && vp run db:supabase:setup",
        "db:migrate:create": "vp run db:supabase:clean && prisma migrate dev --create-only && vp run db:supabase:setup",
        "db:supabase:setup": "vp run db:rls:setup && vp run db:realtime:setup && vp run db:auth-user-trigger:add && vp run db:extensions:setup && vp run db:functions:setup",
        "db:supabase:clean": "vp run db:auth-user-trigger:rm",
        "db:auth-user-trigger:add": "prisma db execute --file ./prisma/auth_user_trigger_add.sql --schema ./prisma/schema.prisma",
        "db:auth-user-trigger:rm": "prisma db execute --file ./prisma/auth_user_trigger_rm.sql --schema ./prisma/schema.prisma",
        "db:rls:setup": "prisma db execute --file ./prisma/rls_setup.sql --schema ./prisma/schema.prisma",
        "db:realtime:setup": "prisma db execute --file ./prisma/realtime_setup.sql --schema ./prisma/schema.prisma",
        "db:extensions:setup": "prisma db execute --file ./prisma/extensions.sql --schema ./prisma/schema.prisma",
        "db:functions:setup": "prisma db execute --file ./prisma/functions.sql --schema ./prisma/schema.prisma",
        "format": "prisma format",
        "db:studio": "prisma studio",
        "ts:check": "tsc --noEmit",
        "build": "prisma generate",
        "postinstall": "vp run build",
        "prisma": "prisma"
    },
    "dependencies": {
        "@prisma/client": "^5.8.1",
        "@supabase/supabase-js": "^1.35.7",
        "axios": "1.1.3",
        "logger": "workspace:*",
        "react": "^18.2.0"
    },
    "devDependencies": {
        "@types/react": "^18.2.31",
        "discord-api-types": "^0.37.25",
        "prisma": "^5.8.1",
        "tsconfig": "workspace:*",
        "typescript": "^5.3.3"
    }
}
