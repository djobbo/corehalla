{
    "name": "@crh/db",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.mts",
        "db:seed:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-verify.mts",
        "db:import:supabase": "node --env-file-if-exists=../../.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-postgres.mts",
        "ts:check": "tsrs --noEmit && effect-tsrs diagnostics --project tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@types/pg": "catalog:",
        "drizzle-kit": "catalog:",
        "pg": "catalog:",
        "typescript": "catalog:"
    },
    "dependencies": {
        "@effect/sql-d1": "catalog:",
        "drizzle-orm": "catalog:",
        "effect": "catalog:"
    }
}
