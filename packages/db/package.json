{
    "name": "db",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --env-file-if-exists=.env scripts/db.mts migrate",
        "db:migrate:prod": "node --env-file-if-exists=.env scripts/db.mts migrate",
        "db:init": "node --env-file-if-exists=.env scripts/db.mts init",
        "db:setup": "node --env-file-if-exists=.env scripts/db.mts setup",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "ts:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/react": "^18.2.31",
        "discord-api-types": "^0.37.25",
        "drizzle-kit": "1.0.0-rc.5-5935859",
        "tsconfig": "workspace:*",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "@effect/sql-pg": "4.0.0-rc.116",
        "@supabase/supabase-js": "^2.116.0",
        "axios": "1.1.3",
        "drizzle-orm": "1.0.0-rc.5-5935859",
        "effect": "4.0.0-rc.116",
        "logger": "workspace:*",
        "react": "^18.2.0"
    }
}
