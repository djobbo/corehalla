# Corehalla (TanStack Start) environment variables
#
# Copy to `.env` for the values you own. `DATABASE_URL` is written into
# `.env.local` by `pnpm setup:env`, which takes it from `supabase status`
# (`.env.local` wins over `.env`).
#
# Server-only values are read at request time and never reach the browser.
# `VITE_`/`NEXT_PUBLIC_` values are inlined into the client bundle and must not
# contain secrets.

# --- server only ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY
# Written by `pnpm setup:env` (Postgres is the only thing Supabase provides).
DATABASE_URL=
SITE_URL=https://dev.corehalla.com
# Discord OAuth application (https://discord.com/developers/applications).
# The redirect URL to register is `${SITE_URL}/api/auth/discord/callback`.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Origin used for server-side atom preloading (defaults to VERCEL_URL or
# http://localhost:$PORT).
INTERNAL_ORIGIN=

# --- public (browser) ---
VITE_GA_TRACKING_ID=
VITE_ADSENSE_ID=
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_ADSENSE_ID=
