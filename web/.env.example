# Corehalla (TanStack Start) environment variables
#
# Server-only values are read at request time and never reach the browser.
# `VITE_`/`NEXT_PUBLIC_` values are inlined into the client bundle and must not
# contain secrets.

# --- server only ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY
SUPABASE_URL=SUPABASE_URL
SUPABASE_SERVICE_KEY=SUPER_SECRET_SUPABASE_SERVICE_KEY
DATABASE_URL=DATABASE_URL
SITE_URL=https://dev.corehalla.com

# --- public (browser) ---
# Both the new `VITE_` name and the legacy `NEXT_PUBLIC_` name are accepted so
# the deployed environment does not have to change during the cutover.
VITE_SUPABASE_URL=SUPABASE_URL
VITE_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY
VITE_GA_TRACKING_ID=
VITE_ADSENSE_ID=
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_ADSENSE_ID=
