# Corehalla (TanStack Start) environment variables
#
# Copy to `.env` for the values you own. The local Supabase URL, keys and
# `DATABASE_URL` are written into `.env.local` by `pnpm setup:env`, which takes
# them from `supabase status` (`.env.local` wins over `.env`).
#
# Server-only values are read at request time and never reach the browser.
# `VITE_`/`NEXT_PUBLIC_` values are inlined into the client bundle and must not
# contain secrets.

# --- server only ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY
# Written by `pnpm setup:env`
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
SITE_URL=https://dev.corehalla.com
# Origin used for server-side atom preloading (defaults to VERCEL_URL or
# http://localhost:$PORT).
INTERNAL_ORIGIN=

# --- public (browser) ---
# Both the new `VITE_` name and the legacy `NEXT_PUBLIC_` name are accepted so
# the deployed environment does not have to change during the cutover.
# Written by `pnpm setup:env`
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_GA_TRACKING_ID=
VITE_ADSENSE_ID=
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_ADSENSE_ID=
