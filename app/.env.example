# Corehalla (legacy Next.js app) environment variables
#
# The local Supabase URL, keys and `DATABASE_URL` are written into `.env.local`
# by `pnpm setup:env`. Legacy `NEXT_PUBLIC_` names are still what this app
# reads.

# --- server only ---
BRAWLHALLA_API_KEY=SUPER_SECRET_API_KEY
# Written by `pnpm setup:env`
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- public (browser) ---
# Written by `pnpm setup:env`
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_ADSENSE_ID=
