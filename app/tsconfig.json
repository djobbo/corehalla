{
    "extends": "tsconfig/base.json",
    "include": [
        "env.d.ts",
        "src/**/*.ts",
        "src/**/*.tsx",
        "components/**/*.ts",
        "components/**/*.tsx",
        "hooks/**/*.ts",
        "hooks/**/*.tsx",
        "providers/**/*.ts",
        "providers/**/*.tsx",
        "util/**/*.ts",
        "util/**/*.tsx",
        "views/**/*.ts",
        "views/**/*.tsx"
    ],
    "exclude": ["node_modules", ".output", "dist"],
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "noEmit": true,
        "declaration": false,
        "declarationMap": false,
        "jsx": "react-jsx",
        "incremental": true,
        "paths": {
            "#/*": ["./*"]
        },
        "types": ["vite/client"]
    }
}
