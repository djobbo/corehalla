{
    "extends": "tsconfig/nextjs.json",
    "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "baseUrl": ".",
        // `server`/`db` re-export Effect and Drizzle, whose packages are
        // ESM-only and expose their entry points only through `exports`
        // (invisible to the legacy `node`/node10 resolution in the base config).
        "moduleResolution": "bundler",
        "paths": {
            "@hooks/*": ["hooks/*"],
            "@components/*": ["components/*"],
            "@ctx/*": ["providers/*"],
            "@util/*": ["util/*"]
        }
    }
}
