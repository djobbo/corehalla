#!/bin/sh
# `typescript.tsdk` launches an executable named `tsgo`.
# Run the Effect-patched tsrs from `@effect/tsgo` so the editor reports the same
# Effect diagnostics as `effect-tsgo tsrs` on the command line.
root="$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)"
exec "$root/node_modules/.bin/effect-tsgo" tsrs "$@"
