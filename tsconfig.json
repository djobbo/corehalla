{
    // Type-checks `alchemy.run.ts` only. Each package checks its own sources.
    "include": ["alchemy.run.ts", "scripts"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "strict": true,
        "target": "es2022",
        "lib": ["esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"],
        "plugins": [
            {
                "name": "@effect/language-service",
                "diagnostics": true,
                "allowedUnstableApis": [
                    "effect/FileSystem",
                    "effect/Path",
                    "effect/process",
                    "@effect/platform-node"
                ],
                "includeSuggestionsInTsc": false,
                "ignoreEffectWarningsInTscExitCode": true
            }
        ]
    }
}
