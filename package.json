{
    "name": "corehalla",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/djobbo/corehalla.git",
    "author": "Djobbo Maïga <hi@djobbo.com>",
    "scripts": {
        "build": "vp run -r build",
        "dev": "vp run -r --parallel dev",
        "dev:cloud": "node --env-file-if-exists=.env --env-file-if-exists=web/.env node_modules/alchemy/bin/cli.js dev",
        "db:generate": "vp run --filter db db:generate",
        "db:seed": "vp run --filter db db:seed",
        "db:seed:verify": "vp run --filter db db:seed:verify",
        "db:import:supabase": "vp run --filter db db:import:supabase",
        "deploy": "node --env-file-if-exists=.env --env-file-if-exists=web/.env node_modules/alchemy/bin/cli.js deploy",
        "destroy": "node --env-file-if-exists=.env node_modules/alchemy/bin/cli.js destroy",
        "dl-roster": "vp run -r dl-roster",
        "ts:check": "tsc --noEmit -p tsconfig.json && vp run -r ts:check",
        "check": "vp check",
        "lint": "vp lint --fix",
        "ci:lint": "vp lint",
        "format": "vp fmt && vp run -r format",
        "ci:install": "vp install --frozen-lockfile"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-rc.116",
        "@types/node": "^24.0.0",
        "alchemy": "2.0.0-beta.79",
        "effect": "4.0.0-rc.116",
        "typescript": "^7.0.2",
        "vite": "^8.0.14",
        "vite-plus": "0.3.3"
    },
    "engines": {
        "npm": ">=7.0.0",
        "node": ">=22.18.0"
    },
    "packageManager": "pnpm@12.5.1"
}
