{
    "name": "corehalla",
    "version": "0.0.0",
    "private": true,
    "author": "Djobbo Maïga <hi@djobbo.com>",
    "repository": "https://github.com/djobbo/corehalla.git",
    "scripts": {
        "build": "vp run -r build",
        "check": "vp check && vp run -r ts:check",
        "lint": "vp lint --fix",
        "format": "vp fmt",
        "ts:check": "vp run -r ts:check",
        "ci:install": "vp install --frozen-lockfile",
        "ci:check": "vp check && vp run -r ts:check",
        "dl-roster": "vp run --filter dl-roster-images dl-roster",
        "db:migrate": "dotenv -e .env -- vp run --filter db db:migrate",
        "db:migrate:prod": "vp run --filter db db:migrate:prod",
        "build:prod": "vp run db:migrate:prod && vp run --filter app... build",
        "dev": "dotenv -e .env -- vp run --filter app dev",
        "setup": "tsx scripts/setup.mts",
        "setup:env": "tsx scripts/setup.mts",
        "services:up": "dotenv -e .env -- vp exec supabase start",
        "services:down": "dotenv -e .env -- vp exec supabase stop",
        "services:status": "dotenv -e .env -- vp exec supabase status",
        "prepare": "vp config"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-beta.68",
        "@types/node": "^20.11.5",
        "@voidzero-dev/vite-plus-core": "^0.1.21",
        "dotenv-cli": "^8.0.0",
        "effect": "4.0.0-beta.68",
        "supabase": "^2.76.10",
        "tsx": "^4.19.2",
        "typescript": "^5.3.3",
        "vite-plus": "^0.1.21"
    },
    "engines": {
        "node": ">=22.12.0",
        "npm": ">=7.0.0"
    },
    "packageManager": "pnpm@11.1.3"
}
