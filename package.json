{
    "name": "corehalla",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/djobbo/corehalla.git",
    "author": "Djobbo Maïga <hi@djobbo.com>",
    "scripts": {
        "build": "vp run -r build",
        "dev": "alchemy dev --env-file .env",
        "db:generate": "vp run --filter @crh/db db:generate",
        "db:seed": "vp run --filter @crh/db db:seed",
        "db:seed:verify": "vp run --filter @crh/db db:seed:verify",
        "db:import:supabase": "vp run --filter @crh/db db:import:supabase",
        "deploy": "alchemy deploy --env-file .env",
        "destroy": "alchemy destroy --env-file .env",
        "dl-roster": "vp run -r dl-roster",
        "ts:check": "tsc --noEmit -p tsconfig.json && vp run -r ts:check",
        "check": "vp check",
        "lint": "vp lint --fix",
        "ci:lint": "vp lint",
        "format": "vp fmt && vp run -r format",
        "ci:install": "vp install --frozen-lockfile"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "alchemy": "2.0.0-beta.79",
        "effect": "4.0.0-rc.117",
        "typescript": "^7.0.2",
        "vite": "^8.0.14",
        "vite-plus": "1.0.0"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "12.5.1"
        },
        "runtime": {
            "name": "node",
            "version": "24.21.0"
        }
    }
}
