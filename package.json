{
    "name": "corehalla",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/djobbo/corehalla.git",
    "author": "Djobbo Maïga <hi@djobbo.com>",
    "scripts": {
        "build": "vp run -r build",
        "build:prod": "pnpm db:migrate:prod && vp run --filter app build",
        "dev": "vp run -r --parallel dev",
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:status": "supabase status",
        "db:migrate": "vp run -r db:migrate",
        "db:migrate:prod": "vp run --filter db db:migrate:prod",
        "dl-roster": "vp run -r dl-roster",
        "ts:check": "vp run -r ts:check",
        "check": "vp check",
        "lint": "vp lint --fix",
        "ci:lint": "vp lint",
        "format": "vp fmt && vp run -r format",
        "ci:install": "vp install --frozen-lockfile",
        "setup:env": "zx setup.zx.mjs"
    },
    "devDependencies": {
        "supabase": "^2.117.0",
        "typescript": "^5.3.3",
        "vite": "^8.0.14",
        "vite-plus": "0.3.3",
        "zx": "^7.2.3"
    },
    "engines": {
        "npm": ">=7.0.0",
        "node": ">=22.18.0"
    },
    "packageManager": "pnpm@8.5.0",
    "pnpm": {
        "overrides": {
            "@types/react": "~19.0.8",
            "@types/react-dom": "~19.0.3",
            "vite@*": "npm:@voidzero-dev/vite-plus-core@0.3.3"
        }
    }
}
