{
    "name": "corehalla",
    "version": "0.0.0",
    "private": true,
    "repository": "https://github.com/djobbo/corehalla.git",
    "author": "Djobbo Maïga <hi@djobbo.com>",
    "scripts": {
        "build": "turbo run build",
        "check": "vp check",
        "lint": "vp lint --fix",
        "format": "vp fmt",
        "ts:check": "turbo run ts:check",
        "ci:install": "pnpm install --frozen-lockfile",
        "ci:check": "vp check",
        "ci:deadcode": "turbo run ci:deadcode",
        "dl-roster": "turbo run dl-roster",
        "db:migrate": "dotenv -e .env -- turbo run db:migrate",
        "db:migrate:prod": "turbo run db:migrate:prod --scope=db --include-dependencies --no-deps",
        "build:prod": "pnpm db:migrate:prod && turbo run build --scope=app --include-dependencies --no-deps",
        "dev": "dotenv -e .env -- pnpm --filter app dev",
        "setup": "tsx scripts/setup.mts",
        "setup:env": "tsx scripts/setup.mts",
        "services:up": "dotenv -e .env -- pnpm exec supabase start",
        "services:down": "dotenv -e .env -- pnpm exec supabase stop",
        "services:status": "dotenv -e .env -- pnpm exec supabase status"
    },
    "devDependencies": {
        "@effect/platform-node": "4.0.0-beta.68",
        "@types/node": "^20.11.5",
        "@voidzero-dev/vite-plus-core": "^0.1.21",
        "dotenv-cli": "^8.0.0",
        "effect": "4.0.0-beta.68",
        "supabase": "^2.76.10",
        "tsx": "^4.19.2",
        "turbo": "^1.11.3",
        "typescript": "^5.3.3",
        "vite-plus": "^0.1.21"
    },
    "engines": {
        "npm": ">=7.0.0",
        "node": ">=22.12.0"
    },
    "packageManager": "pnpm@9.15.9"
}
